# Copy to .env and fill in. .env and .env.* are gitignored.
# For another provider, copy to .env.<name> as well and select it per command:
#   UV_ENV_FILE=.env.<name> mas_harness/run_batch.sh ...
#   UV_ENV_FILE=.env.<name> uv run ... direct_llm/direct_llm.py ...
# Values already set in the shell win over that file; that file wins over .env.
OPENAI_API_KEY=
# OpenRouter (leave out for OpenAI directly). Azure, v1 API: https://<resource>.openai.azure.com/openai/v1/
OPENAI_API_BASE=https://openrouter.ai/api/v1
# Model ids for the MAS harness (OpenRouter needs the provider prefix; Azure uses the deployment name)
HEADLESS_LLM_MODEL=openai/gpt-4o-mini
HEADLESS_LLM_CODE_MODEL=openai/gpt-4o
# Direct-LLM experiment and the simulated manager
DIRECT_LLM_MODEL=openai/gpt-6.1-terra-pro
SIM_USER_MODEL=openai/gpt-6.1-terra-pro
