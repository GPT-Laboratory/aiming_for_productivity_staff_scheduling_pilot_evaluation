# Copy to .env and fill in. .env is gitignored.
OPENAI_API_KEY=
# OpenRouter (leave out for OpenAI directly)
OPENAI_API_BASE=https://openrouter.ai/api/v1
# Model ids for the MAS harness (OpenRouter needs the provider prefix)
HEADLESS_LLM_MODEL=openai/gpt-4o-mini
HEADLESS_LLM_CODE_MODEL=openai/gpt-4o
